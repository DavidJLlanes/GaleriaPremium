server {
    listen 80;
    server_name warpstudio.es www.warpstudio.es;
    root /var/www/warpstudio.es/public;
    index index.php;
    client_max_body_size 64m;   # subidas de fotos

    location / { try_files $uri $uri/ /index.php?$query_string; }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;   # ajusta a tu versión
    }

    location ~* \.(jpg|jpeg|png|webp|avif|css|js|woff2)$ {
        expires 30d; add_header Cache-Control "public, immutable"; access_log off;
    }
    location ~ /\.(?!well-known) { deny all; }
}
