# Configuración de Nginx para __DOMAIN__ (root = carpeta public/, solo se ejecuta index.php)
#SSL#server {
#SSL#    listen 80;
#SSL#    listen [::]:80;
#SSL#    server_name __DOMAIN__ www.__DOMAIN__;
#SSL#    return 301 https://$server_name$request_uri;
#SSL#}

server {
#SSL#    listen 443 ssl http2;
#SSL#    listen [::]:443 ssl http2;
#NOSSL#    listen 80;
#NOSSL#    listen [::]:80;
    server_name __DOMAIN__ www.__DOMAIN__;

    root /var/www/__DOMAIN__/public;
    index index.php;
    charset utf-8;
    client_max_body_size 64m;            # subida de fotos

#SSL#    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
#SSL#    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
#SSL#    include /etc/letsencrypt/options-ssl-nginx.conf;
#SSL#    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/www/__DOMAIN__/log/access.log;
    error_log  /var/www/__DOMAIN__/log/error.log;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / { try_files $uri $uri/ /index.php?$query_string; }

    # Solo index.php se ejecuta; cualquier otro .php (p. ej. uploads) responde 404
    location = /index.php {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php-fpm.sock;
        fastcgi_read_timeout 120s;
    }
    location ~ \.php$ { return 404; }

    # Ficheros ocultos (.user.ini, .git...) nunca
    location ~ /\.(?!well-known) { deny all; }

    # Estáticos con caché larga (los CSS/JS llevan ?v=fecha, las fotos nombres únicos)
    location ~* \.(css|js|webp|jpg|jpeg|png|gif|svg|ico|woff2|woff|ttf|otf)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }
}
